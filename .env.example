# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend API Configuration
NEXT_PUBLIC_API_URL="/api"

# Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sentrova
DB_USER=sentrova_user
DB_PASSWORD=your_secure_password
JWT_SECRET=your_super_strong_random_jwt_secret_key_minimum_32_characters
CORS_ORIGIN=https://sentrova.co.uk

# SMTP Email Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=monitoring@sentrovaglobal.com
SMTP_PASS=your_email_password
SMTP_FROM="SENTROVA Operations <monitoring@sentrovaglobal.com>"
ADMIN_NOTIFICATION_EMAIL=monitoring@sentrova.co.uk

